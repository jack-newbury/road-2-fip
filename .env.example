NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=sk-...
# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Kourtos Partner API (recommended) — kos_live_… key from /partner portal
KOURTOS_API_BASE=https://app.kourtos.com/api/v1
KOURTOS_PARTNER_API_TOKEN=kos_live_...
# Filter platform results to you (full name as on fixtures, or stable player UUID)
KOURTOS_PLAYER_NAME=Jack Newbury
# KOURTOS_PLAYER_ID=

# Optional: also set user login to enrich Playtomic level from /stats/overview
# KOURTOS_EMAIL=
# KOURTOS_PASSWORD=
# KOURTOS_ACCESS_TOKEN=
